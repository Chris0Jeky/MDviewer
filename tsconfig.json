{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": ["vite/client", "node", "vite-plugin-pwa/client"]
  },
  "include": ["src", "tests", "vite.config.ts", "vite.desktop.config.ts", "vite.embed.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.desktop.config.ts", "playwright.embed.config.ts", "playwright.authoring.config.ts", "playwright.webhost.config.ts"],
  "exclude": ["node_modules", "dist"]
}
