{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled reader can receive selected documents, save them in place through their capability tokens, and open explicitly clicked web links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-set-always-on-top",
    "allow-open-files",
    "allow-take-pending-files",
    "allow-open-external",
    "allow-save-export",
    "allow-patch-document",
    "allow-save-document",
    "allow-save-document-as",
    "allow-release-document",
    "allow-read-document",
    "allow-library-list",
    "allow-library-scan",
    "allow-library-open",
    "allow-library-pin",
    "allow-library-unpin",
    "allow-library-forget",
    "allow-library-mark-seen",
    "allow-library-add-project",
    "allow-library-clear",
    "allow-open-relative",
    "allow-read-asset",
    "allow-session-record",
    "allow-session-restore",
    "allow-session-setting"
  ]
}
