{
  "name": "mdviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based, drag-and-drop Markdown to PDF viewer with page-break-safe pagination for research and code documents.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-license-bundle.mjs",
    "start": "node scripts/start.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:authoring": "playwright test --config playwright.authoring.config.ts",
    "agent:hooks:smoke": "node scripts/run-python.mjs scripts/agent_hooks/smoke_test.py",
    "agent:skills:validate": "node scripts/run-python.mjs scripts/agent_hooks/validate_skills.py",
    "agent:ledger:render": "node scripts/run-python.mjs scripts/agent_hooks/render_failure_ledger.py",
    "agent:observatory:check": "node observatory/check.mjs",
    "test:serve": "node --test scripts/serve.test.mjs",
    "smoke:egress": "node scripts/smoke-egress.mjs",
    "agent:check": "npm run typecheck && npm run lint && npm run test && npm run test:serve && npm run agent:observatory:check",
    "desktop:dev:web": "vite --config vite.desktop.config.ts --port 5182 --strictPort",
    "desktop:build:web": "tsc --noEmit && vite build --config vite.desktop.config.ts && node scripts/generate-license-bundle.mjs dist-desktop",
    "embed:build": "tsc --noEmit && vite build --config vite.embed.config.ts",
    "embed:test": "playwright test --config playwright.embed.config.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --ci -- --locked",
    "desktop:test": "playwright test --config playwright.desktop.config.ts",
    "desktop:licenses": "node scripts/desktop-native-licenses.mjs --out desktop-artifacts/NATIVE_THIRD_PARTY_NOTICES.txt"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@shikijs/core": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/markdown-it": "^4.6.0",
    "@shikijs/themes": "^4.3.1",
    "@shikijs/transformers": "^4.6.0",
    "@tauri-apps/api": "2.12.4",
    "@vscode/markdown-it-katex": "^1.1.0",
    "dompurify": "^3.4.17",
    "html2canvas-pro": "2.6.0",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "mermaid": "^12.2.0",
    "pagedjs": "^0.4.3",
    "shiki": "^4.3.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    },
    "eslint": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "workbox-build": {
      "glob": "14.0.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/katex": "^0.16.7",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "6.5.438",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
